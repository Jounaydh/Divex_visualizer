{
  "name": "divex-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "A beginner-friendly 3D code visualizer for understanding projects, dependencies, and execution structure.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm run build",
    "preview": "vite preview",
    "desktop": "electron .",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "ace-builds": "^1.44.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.6",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.1": true
  }
}
